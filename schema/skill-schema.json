{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RightSkillsSkillMetadata",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "version": { "type": "string" },
    "license": { "type": "string" },
    "target_apps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "jobs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "security_grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "F"]
    },
    "test_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": ["id", "title", "description", "author", "version", "license", "target_apps", "jobs"]
}
